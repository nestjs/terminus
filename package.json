{
  "name": "@nestjs/terminus",
  "version": "11.1.1",
  "description": "Terminus integration provides readiness/liveness health checks for NestJS.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs/terminus"
  },
  "keywords": [
    "nestjs",
    "healt-checks",
    "express",
    "fastify",
    "typeorm",
    "microorm",
    "mongoose",
    "sequelize",
    "grpc",
    "kafka",
    "rabbitmq",
    "nats",
    "redis",
    "amqp",
    "amqplib",
    "axios",
    "prisma"
  ],
  "license": "MIT",
  "author": "Livio Brunner",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "rimraf dist && tsc -p tsconfig.build.json && cp -R lib/health-indicator/microservice/protos dist/health-indicator/microservice/",
    "build:all": "pnpm run build && pnpm run -r build",
    "test:all": "pnpm run test && pnpm run -r --if-present test",
    "test:e2e:all": "pnpm run test:e2e && pnpm run -r --if-present test:e2e",
    "format": "prettier --check \"{lib,e2e,sample,tools}/**/*.ts\"",
    "format:fix": "prettier --write \"{lib,e2e,sample,tools}/**/*.ts\"",
    "lint": "oxlint lib e2e tools",
    "lint:fix": "oxlint --fix lib e2e tools",
    "typecheck": "tsc -p tsconfig.json",
    "precommit": "lint-staged",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "test": "pnpm run test:ut && pnpm run test:import",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:ut": "vitest run",
    "test:import": "node tools/import-check.mjs",
    "test:pack": "pnpm run build && node tools/pack-check.mjs",
    "release": "release-it",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-angular": "catalog:",
    "@grpc/grpc-js": "catalog:",
    "@grpc/proto-loader": "catalog:",
    "@mikro-orm/core": "catalog:",
    "@mikro-orm/mongodb": "catalog:",
    "@mikro-orm/mysql": "catalog:",
    "@mikro-orm/nestjs": "catalog:",
    "@nestjs/axios": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/mongoose": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/sequelize": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "@prisma/client": "catalog:",
    "@release-it/conventional-changelog": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "amqp-connection-manager": "catalog:",
    "amqplib": "catalog:",
    "axios": "catalog:",
    "express": "catalog:",
    "fastify": "catalog:",
    "husky": "catalog:",
    "kafkajs": "catalog:",
    "lint-staged": "catalog:",
    "mongoose": "catalog:",
    "mysql2": "catalog:",
    "oxlint": "catalog:",
    "portfinder": "catalog:",
    "prettier": "catalog:",
    "prisma": "catalog:",
    "reflect-metadata": "catalog:",
    "release-it": "catalog:",
    "rimraf": "catalog:",
    "rxjs": "catalog:",
    "sequelize": "catalog:",
    "sequelize-typescript": "catalog:",
    "supertest": "catalog:",
    "typeorm": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wait-port": "catalog:"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "*",
    "@grpc/proto-loader": "*",
    "@mikro-orm/core": "*",
    "@mikro-orm/nestjs": "*",
    "@nestjs/axios": "^4.0.0 || ^12.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/microservices": "^11.0.0 || ^12.0.0",
    "@nestjs/mongoose": "^11.0.0 || ^12.0.0",
    "@nestjs/sequelize": "^11.0.0 || ^12.0.0",
    "@nestjs/swagger": "^11.0.0 || ^12.0.0",
    "@nestjs/typeorm": "^11.0.0 || ^12.0.0",
    "@prisma/client": "*",
    "mongoose": "*",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0",
    "sequelize": "*",
    "typeorm": "*"
  },
  "peerDependenciesMeta": {
    "@grpc/grpc-js": {
      "optional": true
    },
    "@grpc/proto-loader": {
      "optional": true
    },
    "@mikro-orm/core": {
      "optional": true
    },
    "@mikro-orm/nestjs": {
      "optional": true
    },
    "@nestjs/axios": {
      "optional": true
    },
    "@nestjs/microservices": {
      "optional": true
    },
    "@nestjs/mongoose": {
      "optional": true
    },
    "@nestjs/sequelize": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "@nestjs/typeorm": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    },
    "sequelize": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true
  },
  "renovate": {
    "semanticCommits": true,
    "packageRules": [
      {
        "matchDepTypes": [
          "devDependencies"
        ],
        "automerge": true
      }
    ],
    "extends": [
      "config:recommended"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-angular"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "ci",
          "docs",
          "feat",
          "fix",
          "perf",
          "refactor",
          "revert",
          "style",
          "test",
          "sample"
        ]
      ]
    }
  },
  "main": "./dist/index.js"
}
